    float layerMetallic[12] = {_LTRoadTerrainLayers[tile*12u+0u].settings.y,_LTRoadTerrainLayers[tile*12u+1u].settings.y,_LTRoadTerrainLayers[tile*12u+2u].settings.y,_LTRoadTerrainLayers[tile*12u+3u].settings.y,_LTRoadTerrainLayers[tile*12u+4u].settings.y,_LTRoadTerrainLayers[tile*12u+5u].settings.y,_LTRoadTerrainLayers[tile*12u+6u].settings.y,_LTRoadTerrainLayers[tile*12u+7u].settings.y,_LTRoadTerrainLayers[tile*12u+8u].settings.y,_LTRoadTerrainLayers[tile*12u+9u].settings.y,_LTRoadTerrainLayers[tile*12u+10u].settings.y,_LTRoadTerrainLayers[tile*12u+11u].settings.y};
    // Per-layer RGB mask controls: flags = normal present, AO strength, height contrast, height offset.
    masks[0].x = saturate(1.0 + (masks[0].x - 1.0) * _LTRoadTerrainLayers[tile*12u+0u].flags.y);
    masks[0].y = saturate((masks[0].y - .5) * _LTRoadTerrainLayers[tile*12u+0u].flags.z + .5 + _LTRoadTerrainLayers[tile*12u+0u].flags.w);
    masks[1].x = saturate(1.0 + (masks[1].x - 1.0) * _LTRoadTerrainLayers[tile*12u+1u].flags.y);
    masks[1].y = saturate((masks[1].y - .5) * _LTRoadTerrainLayers[tile*12u+1u].flags.z + .5 + _LTRoadTerrainLayers[tile*12u+1u].flags.w);
    masks[2].x = saturate(1.0 + (masks[2].x - 1.0) * _LTRoadTerrainLayers[tile*12u+2u].flags.y);
    masks[2].y = saturate((masks[2].y - .5) * _LTRoadTerrainLayers[tile*12u+2u].flags.z + .5 + _LTRoadTerrainLayers[tile*12u+2u].flags.w);
    masks[3].x = saturate(1.0 + (masks[3].x - 1.0) * _LTRoadTerrainLayers[tile*12u+3u].flags.y);
    masks[3].y = saturate((masks[3].y - .5) * _LTRoadTerrainLayers[tile*12u+3u].flags.z + .5 + _LTRoadTerrainLayers[tile*12u+3u].flags.w);
    masks[4].x = saturate(1.0 + (masks[4].x - 1.0) * _LTRoadTerrainLayers[tile*12u+4u].flags.y);
    masks[4].y = saturate((masks[4].y - .5) * _LTRoadTerrainLayers[tile*12u+4u].flags.z + .5 + _LTRoadTerrainLayers[tile*12u+4u].flags.w);
    masks[5].x = saturate(1.0 + (masks[5].x - 1.0) * _LTRoadTerrainLayers[tile*12u+5u].flags.y);
    masks[5].y = saturate((masks[5].y - .5) * _LTRoadTerrainLayers[tile*12u+5u].flags.z + .5 + _LTRoadTerrainLayers[tile*12u+5u].flags.w);
    masks[6].x = saturate(1.0 + (masks[6].x - 1.0) * _LTRoadTerrainLayers[tile*12u+6u].flags.y);
    masks[6].y = saturate((masks[6].y - .5) * _LTRoadTerrainLayers[tile*12u+6u].flags.z + .5 + _LTRoadTerrainLayers[tile*12u+6u].flags.w);
    masks[7].x = saturate(1.0 + (masks[7].x - 1.0) * _LTRoadTerrainLayers[tile*12u+7u].flags.y);
    masks[7].y = saturate((masks[7].y - .5) * _LTRoadTerrainLayers[tile*12u+7u].flags.z + .5 + _LTRoadTerrainLayers[tile*12u+7u].flags.w);
    masks[8].x = saturate(1.0 + (masks[8].x - 1.0) * _LTRoadTerrainLayers[tile*12u+8u].flags.y);
    masks[8].y = saturate((masks[8].y - .5) * _LTRoadTerrainLayers[tile*12u+8u].flags.z + .5 + _LTRoadTerrainLayers[tile*12u+8u].flags.w);
    masks[9].x = saturate(1.0 + (masks[9].x - 1.0) * _LTRoadTerrainLayers[tile*12u+9u].flags.y);
    masks[9].y = saturate((masks[9].y - .5) * _LTRoadTerrainLayers[tile*12u+9u].flags.z + .5 + _LTRoadTerrainLayers[tile*12u+9u].flags.w);
    masks[10].x = saturate(1.0 + (masks[10].x - 1.0) * _LTRoadTerrainLayers[tile*12u+10u].flags.y);
    masks[10].y = saturate((masks[10].y - .5) * _LTRoadTerrainLayers[tile*12u+10u].flags.z + .5 + _LTRoadTerrainLayers[tile*12u+10u].flags.w);
    masks[11].x = saturate(1.0 + (masks[11].x - 1.0) * _LTRoadTerrainLayers[tile*12u+11u].flags.y);
    masks[11].y = saturate((masks[11].y - .5) * _LTRoadTerrainLayers[tile*12u+11u].flags.z + .5 + _LTRoadTerrainLayers[tile*12u+11u].flags.w);
    float maxHeight = -1;
    [unroll] for(int i=0;i<12;i++) if(weights[i] > .00001) maxHeight=max(maxHeight,masks[i].y+weights[i]);
    float total=0;
    [unroll] for(int j=0;j<12;j++)
    {
        if(_LTRoadTerrainChunks[tile].options.x > .0001)
            weights[j] *= lerp(1,saturate((masks[j].y+weights[j]-maxHeight+.2)/.2),_LTRoadTerrainChunks[tile].options.x);
        total+=weights[j];
    }
    color=0; float3 n=0; ao=0; smoothness=0; metallic=0;
    [unroll] for(int k=0;k<12;k++)
    {
        float w=weights[k]/max(total,.00001);
        color+=colors[k]*w; n+=normals[k]*w;
        ao+=masks[k].x*w; smoothness+=masks[k].z*w; metallic+=layerMetallic[k]*w;
    }
    if(_LTRoadTerrainChunks[tile].options.w>.5)
    {
        // In spline-enabled chunks each layer contributes a gradient in the SAME
        // terrain frame, before the smooth layer blend. The planar tangent frame
        // is +X/+Z; projected callers consume gradientLocal directly.
        gradientLocal=n;
        normalTS=normalize(float3(-n.x,-n.z,1));
    }
    else
    {
        normalTS=normalize(n+float3(0,0,.00001));
        gradientLocal=LTAutoProjectionGradient(tile,normalTS,projectionAxis);
    }
}

void LTAutoSampleLayersMappedFrameWithCoverage(uint tile,float2 coveragePosition,float2 coverageDx,float2 coverageDy,
    float2 position,float2 uvDx,float2 uvDy,int projectionAxis,float4 w0,float4 w1,float4 w2,
    out float3 color,out float3 normalTS,out float ao,out float smoothness,out float metallic,out float3 gradientLocal)
{
    [branch] if(_LTRoadTerrainChunks[tile].fastLayerParams.x>=0 && _LTRoadTerrainChunks[tile].fastLayerParams.z>.5 && _LTRoadTerrainChunks[tile].fastLayerParams.w>.5 && _LTRoadTerrainChunks[tile].options.z<=.5)
    {
        LTAutoLayerPairData first,second;LTAutoPrepareLayerPair(tile,w0,w1,w2,first,second);
        LTAutoSampleLayerPair(tile,first,second,coveragePosition,coverageDx,coverageDy,position,uvDx,uvDy,projectionAxis,
            color,normalTS,ao,smoothness,metallic,gradientLocal);
        LTAutoBlendPairRemainderColor(tile,first,second,w0,w1,w2,coveragePosition,coverageDx,coverageDy,position,uvDx,uvDy,color);return;
    }
    [branch] if(_LTRoadTerrainChunks[tile].fastLayerParams.x>=0)
        LTAutoSampleLayersMappedFrameWithCoverageFast(tile,coveragePosition,coverageDx,coverageDy,position,uvDx,uvDy,projectionAxis,w0,w1,w2,color,normalTS,ao,smoothness,metallic,gradientLocal);
    else
        LTAutoSampleLayersMappedFrameWithCoverageFull(tile,coveragePosition,coverageDx,coverageDy,position,uvDx,uvDy,projectionAxis,w0,w1,w2,color,normalTS,ao,smoothness,metallic,gradientLocal);
}

// Keep planar and other existing callers on the same sampling implementation.
void LTAutoSampleLayersMappedFrame(uint tile,float2 coveragePosition,float2 coverageDx,float2 coverageDy,
    float2 position,float2 uvDx,float2 uvDy,int projectionAxis,
    out float3 color,out float3 normalTS,out float ao,out float smoothness,out float metallic,
    out float3 gradientLocal)
{
    float4 w0,w1,w2;LTAutoReadLayerCoverage(tile,coveragePosition,w0,w1,w2);
    LTAutoSampleLayersMappedFrameWithCoverage(tile,coveragePosition,coverageDx,coverageDy,position,uvDx,uvDy,projectionAxis,
        w0,w1,w2,color,normalTS,ao,smoothness,metallic,gradientLocal);
}

void LTAutoSampleLayersMapped(uint tile,float2 coveragePosition,float2 position,float2 uvDx,float2 uvDy,
    out float3 color,out float3 normalTS,out float ao,out float smoothness,out float metallic)
{
    // Legacy planar caller: its coverage and texture projection are both XZ.
    float3 unused;
    LTAutoSampleLayersMappedFrame(tile,coveragePosition,uvDx,uvDy,position,uvDx,uvDy,1,
        color,normalTS,ao,smoothness,metallic,unused);
}

// Existing terrain and atlas callers keep their XZ mapping unchanged.
void LTAutoSampleLayers(uint tile,float2 position,float2 uvDx,float2 uvDy,out float3 color,out float3 normalTS,out float ao,out float smoothness,out float metallic)
{
    LTAutoSampleLayersMapped(tile,position,position,uvDx,uvDy,color,normalTS,ao,smoothness,metallic);
}

// Shared by live shading and the geometry-aware far-atlas baker.
// Texture normal gradients only: never reconstruct normals from displacement.
void LTAutoSampleProjectedLayersGrad(uint tile,float3 p,float3 normalWS,bool triplanar,float3 dx,float3 dy,
    out float3 color,out float3 gradientWS,out float ao,out float smoothness,out float metallic)
{
    float3 n=normalize(mul((float3x3)_LTSurfaceWorldToLocal,normalWS));
    float3 weights=triplanar?pow(abs(n),4):float3(0,1,0);
    weights/=max(dot(weights,float3(1,1,1)),.00001);
if(_LTRoadTerrainChunks[tile].fastLayerParams.x>=0)
{
    // Continuous, symmetric reduction avoids hard axis swaps/seams. Preserve all
    // three significant axes at corners; never force biplanar's triple-point pinch.
    weights=max(weights-clamp(_LTRoadTerrainChunks[tile].fastLayerParams.y,0,.15),0);
    weights/=max(dot(weights,float3(1,1,1)),.00001);
}
    color=0;gradientWS=0;ao=0;smoothness=0;metallic=0;
    float3 gradient=0;
    float4 w0,w1,w2;LTAutoReadLayerCoverage(tile,p.xz,w0,w1,w2);
[branch] if(_LTRoadTerrainChunks[tile].fastLayerParams.x>=0 && _LTRoadTerrainChunks[tile].fastLayerParams.z>.5 && _LTRoadTerrainChunks[tile].fastLayerParams.w>.5)
{
    [branch] if(_LTRoadTerrainChunks[tile].options.z<=.5)
    {
        LTAutoLayerPairData first,second;LTAutoPrepareLayerPair(tile,w0,w1,w2,first,second);
        [loop] for(int axis=0;axis<3;axis++)
        {
            if(weights[axis]<=.00001)continue;
            float2 uv=axis==0?p.zy:axis==1?p.xz:p.xy;
            float2 ux=axis==0?dx.zy:axis==1?dx.xz:dx.xy;
            float2 uy=axis==0?dy.zy:axis==1?dy.xz:dy.xy;
            float3 c=0,tn=0,g=0;float a=1,s=0,m=0;
            LTAutoSampleLayerPair(tile,first,second,p.xz,dx.xz,dy.xz,uv,ux,uy,axis,c,tn,a,s,m,g);
#if 1
            LTAutoBlendPairRemainderColor(tile,first,second,w0,w1,w2,p.xz,dx.xz,dy.xz,uv,ux,uy,c);
#endif // _LT_FAST_COLOR_REMAINDER
            color+=weights[axis]*c;gradient+=weights[axis]*g;
            ao+=weights[axis]*a;smoothness+=weights[axis]*s;metallic+=weights[axis]*m;
        }
        gradientWS=mul(gradient,(float3x3)_LTSurfaceWorldToLocal);
        gradientWS-=normalWS*dot(normalWS,gradientWS);return;
    }
}
    [loop] for(int axis=0;axis<3;axis++)
    {
        if(weights[axis]<=.00001)continue;
        float2 uv=axis==0?p.zy:axis==1?p.xz:p.xy;
        float2 ux=axis==0?dx.zy:axis==1?dx.xz:dx.xy;
        float2 uy=axis==0?dy.zy:axis==1?dy.xz:dy.xy;
        float3 c=0,tn=0,g=0;float a=1,s=0,m=0;
        // Roads always sample their XZ spline frame, including on side projections.
        // Rotate each road normal before blending it with the other layer gradients.
        LTAutoSampleLayersMappedFrameWithCoverage(tile,p.xz,dx.xz,dy.xz,uv,ux,uy,axis,w0,w1,w2,c,tn,a,s,m,g);
        color+=weights[axis]*c;gradient+=weights[axis]*g;
        ao+=weights[axis]*a;smoothness+=weights[axis]*s;metallic+=weights[axis]*m;
    }
    gradientWS=mul(gradient,(float3x3)_LTSurfaceWorldToLocal);
    gradientWS-=normalWS*dot(normalWS,gradientWS);
}
void LTAutoSampleProjectedLayers(uint tile,float3 p,float3 normalWS,bool triplanar,
    out float3 color,out float3 gradientWS,out float ao,out float smoothness,out float metallic)
{
    float3 dx=0,dy=0;
#if !defined(SHADER_STAGE_RAY_TRACING)
    dx=ddx(p);dy=ddy(p);
#endif
    LTAutoSampleProjectedLayersGrad(tile,p,normalWS,triplanar,dx,dy,color,gradientWS,ao,smoothness,metallic);
}

int LTRoadTerrainTile(float2 p)
{
    if(_LTRoadTerrainReady<.5)return -1;
    float2 relative=p/_LTRoadTerrainCell.xy-_LTRoadTerrainGrid.xy;
    if(any(relative<0)||any(relative>_LTRoadTerrainGrid.zw))return -1;
    int2 cell=min((int2)floor(relative),(int2)_LTRoadTerrainGrid.zw-1);
    return (int)LOAD_TEXTURE2D(_LTRoadTerrainLookup,cell).r-1;
}
void LTSampleRoadTerrain(float3 p,float3 normalWS,float3 dx,float3 dy,
    out float3 color,out float3 gradient,out float ao,out float smoothness,out float metallic)
{
    int tile=LTRoadTerrainTile(p.xz);
    color=0;gradient=0;ao=1;smoothness=0;metallic=0;
    if(tile<0)return;
    LTAutoSampleProjectedLayersGrad((uint)tile,p,normalWS,_LTRoadTerrainChunks[tile].options.y>.5,dx,dy,color,gradient,ao,smoothness,metallic);
}
