// GENERATED by Tests/RoadTerrainBlendShader.mjs from the live terrain sampling sources.
// Adapts per-chunk addressing/context and shares identically configured layer samplers.
// Check this file against the sources whenever terrain blend math changes.
#include "Assets/TerrainSystem/LocalTerrain/Shaders/LTLayerNormal.hlsl"
struct LTRoadTerrainChunk { float4 rect; float4 options; float4 fastLayerParams; };
struct LTRoadTerrainLayer { float4 tiling; float4 tint; float4 settings; float4 flags; float4 indices; float4 asphaltStyle; };
StructuredBuffer<LTRoadTerrainChunk> _LTRoadTerrainChunks;
StructuredBuffer<LTRoadTerrainLayer> _LTRoadTerrainLayers;
TEXTURE2D(_LTRoadTerrainLookup);
TEXTURE2D_ARRAY(_LTRoadTerrainWeights);
float4 LTAutoAsphaltStyle(uint tile,int slot) { return _LTRoadTerrainLayers[tile*12u+(uint)slot].asphaltStyle; }
float LTAutoRoadSlot(uint tile,int slot) { return _LTRoadTerrainLayers[tile*12u+(uint)slot].indices.y; }
float LTAutoLayerSlice(uint tile,int slot) { return _LTRoadTerrainLayers[tile*12u+(uint)slot].indices.x; }
// Uniforms live in UnityPerMaterial in both the live shader and atlas baker.
// abs(slot)-1 is the slice; negative slots have an adjacent Jacobian slice.
// Zero retains the original projection.
TEXTURE2D_ARRAY(_LTRoadTerrainProjection);


float LTAutoRoadSlice(uint tile,int slot) { return abs(LTAutoRoadSlot(tile,slot))-1; }
float2 LTAutoRoadRight(uint tile,float2 r) { return dot(r,r)>1e-12?normalize(r):float2(1,0); }
// Explicit bilinear evaluation also supplies a Jacobian for mip selection. No
// derivatives inside divergent layer branches; domain and fragment use identical UV.
float4 LTAutoRoadMap(uint tile,float2 position,float slice,out float2 uvX,out float2 uvZ)
{
    float2 p=saturate((position-_LTRoadTerrainChunks[tile].rect.xy)/_LTRoadTerrainChunks[tile].rect.zw)*256;
    int2 cell=min((int2)floor(p),int2(255,255));
    float2 f=p-cell;
    float4 a=LOAD_TEXTURE2D_ARRAY(_LTRoadTerrainProjection,cell,(int)slice);
    float4 b=LOAD_TEXTURE2D_ARRAY(_LTRoadTerrainProjection,cell+int2(1,0),(int)slice);
    float4 c=LOAD_TEXTURE2D_ARRAY(_LTRoadTerrainProjection,cell+int2(0,1),(int)slice);
    float4 d=LOAD_TEXTURE2D_ARRAY(_LTRoadTerrainProjection,cell+int2(1,1),(int)slice);
    uvX=lerp(b.xy-a.xy,d.xy-c.xy,f.y)*(256/_LTRoadTerrainChunks[tile].rect.z);
    uvZ=lerp(c.xy-a.xy,d.xy-b.xy,f.x)*(256/_LTRoadTerrainChunks[tile].rect.w);
    return lerp(lerp(a,b,f.x),lerp(c,d,f.x),f.y);
}
float LTAutoRoadOwner(uint tile,float4 value) { return floor(length(value.zw)+.5); }
float4 LTAutoRoadNetworkMap(uint tile,float2 position,float slice,out float2 uvX,out float2 uvZ)
{
    float2 p=saturate((position-_LTRoadTerrainChunks[tile].rect.xy)/_LTRoadTerrainChunks[tile].rect.zw)*256;
    int2 cell=min((int2)floor(p),int2(255,255));float2 f=p-cell;
    float4 a=LOAD_TEXTURE2D_ARRAY(_LTRoadTerrainProjection,cell,(int)slice);
    float4 b=LOAD_TEXTURE2D_ARRAY(_LTRoadTerrainProjection,cell+int2(1,0),(int)slice);
    float4 c=LOAD_TEXTURE2D_ARRAY(_LTRoadTerrainProjection,cell+int2(0,1),(int)slice);
    float4 d=LOAD_TEXTURE2D_ARRAY(_LTRoadTerrainProjection,cell+int2(1,1),(int)slice);
    float owner=LTAutoRoadOwner(tile,a);
    if(owner==LTAutoRoadOwner(tile,b)&&owner==LTAutoRoadOwner(tile,c)&&owner==LTAutoRoadOwner(tile,d))
    {
        uvX=lerp(b.xy-a.xy,d.xy-c.xy,f.y)*(256/_LTRoadTerrainChunks[tile].rect.z);
        uvZ=lerp(c.xy-a.xy,d.xy-b.xy,f.x)*(256/_LTRoadTerrainChunks[tile].rect.w);
        return lerp(lerp(a,b,f.x),lerp(c,d,f.x),f.y);
    }
    int2 offset=int2(f.x>=.5?1:0,f.y>=.5?1:0);
    float4 chosen=LOAD_TEXTURE2D_ARRAY(_LTRoadTerrainProjection,cell+offset,(int)slice);
    if(LTAutoRoadOwner(tile,chosen)<.5)
    {
        float best=-1;
        [unroll] for(int z=0;z<2;z++)[unroll] for(int x=0;x<2;x++)
        {
            float4 candidate=LOAD_TEXTURE2D_ARRAY(_LTRoadTerrainProjection,cell+int2(x,z),(int)slice);
            float weight=(x==0?1-f.x:f.x)*(z==0?1-f.y:f.y);
            if(LTAutoRoadOwner(tile,candidate)>.5&&weight>best){best=weight;offset=int2(x,z);chosen=candidate;}
        }
    }
    float4 jacobian=LOAD_TEXTURE2D_ARRAY(_LTRoadTerrainProjection,cell+offset,(int)slice+1);
    uvX=jacobian.xy;uvZ=jacobian.zw;
    chosen.xy+=uvX*((f.x-offset.x)*_LTRoadTerrainChunks[tile].rect.z/256)+uvZ*((f.y-offset.y)*_LTRoadTerrainChunks[tile].rect.w/256);
    return chosen;
}
void LTAutoRoadMappedUV(uint tile,int slot,float2 coveragePosition,float2 coverageDx,float2 coverageDy,
    inout float2 uv,inout float2 dx,inout float2 dy,out float2 right)
{
    right=float2(1,0);
    [branch] if(_LTRoadTerrainChunks[tile].options.w>.5)
    {
        float slice=LTAutoRoadSlice(tile,slot);
        [branch] if(slice>=0)
        {
            float2 ux,uz;float4 map;
            if(LTAutoRoadSlot(tile,slot)<0)map=LTAutoRoadNetworkMap(tile,coveragePosition,slice,ux,uz);
            else map=LTAutoRoadMap(tile,coveragePosition,slice,ux,uz);
            uv=map.xy;right=LTAutoRoadRight(tile,map.zw);
            dx=ux*coverageDx.x+uz*coverageDx.y;
            dy=ux*coverageDy.x+uz*coverageDy.y;
        }
    }
}

float2 LTAutoRoadRotate(uint tile,float2 v,float2 right)
{
    // U points right, V points forward. Positive Z road: identity mapping.
    return v.x*right+v.y*float2(-right.y,right.x);
}
float3 LTAutoProjectionGradient(uint tile,float3 n,int axis)
{
    float2 slope=-n.xy/max(n.z,.0001);
    return axis==0?float3(0,slope.y,slope.x):axis==1?float3(slope.x,0,slope.y):float3(slope.x,slope.y,0);
}
float3 LTAutoRoadLayerGradient(uint tile,int slot,float3 normalTS,float2 right,int axis)
{
    if(LTAutoRoadSlice(tile,slot)>=0)
    {
        float2 slope=LTAutoRoadRotate(tile,-normalTS.xy/max(normalTS.z,.0001),right);
        return float3(slope.x,0,slope.y);
    }
    return LTAutoProjectionGradient(tile,normalTS,axis);
}

TEXTURE2D_ARRAY(_LTRoadTerrainCracks);
TEXTURE2D_ARRAY(_LTRoadTerrainDamage);

void LTAutoApplyAsphaltCracks(uint tile,int slot,float2 position,float2 dx,float2 dy,float2 right,
    inout float3 color,inout float3 normalTS,inout float3 mask)
{
    float4 style=LTAutoAsphaltStyle(tile,slot);
    [branch] if(style.x<.5)return;
    float2 coverage=((position-_LTRoadTerrainChunks[tile].rect.xy)/_LTRoadTerrainChunks[tile].rect.zw*256+.5)/257;
    float2 influence=SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainDamage,sampler_LinearClamp,coverage,style.x-1,0).rg;
    // G was unused. Broad repair patches reuse this fetch, asphalt slot and UVs;
    // they do not add a renderer, terrain layer or per-fragment noise loop.
    float repair=saturate(influence.g);
    color*=1-.32*repair;
    mask.z=lerp(mask.z,.28,repair*.65);
    float strength=influence.r*(1-.85*repair);
    [branch] if(strength<=.0001)return;
    // Isotropic crack pattern in terrain-local metres; the asphalt base remains spline-projected.
    float2 uv=position/max(style.z,.1);float4 detail;
#if defined(SHADER_STAGE_RAY_TRACING)
    detail=SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainCracks,sampler_LinearRepeat,uv,style.y,0);
#else
    detail=SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainCracks,sampler_LinearRepeat,uv,style.y,dx/max(style.z,.1),dy/max(style.z,.1));
#endif
    float amount=saturate(detail.r*strength);
    color*=1-.7*amount;
    mask.x*=1-.35*amount;mask.z=lerp(mask.z,.12,amount);
    float2 worldPerturbation=(detail.gb*2-1)*strength*.65;
    float2 forward=float2(-right.y,right.x);
    normalTS=normalize(float3(normalTS.xy+float2(dot(worldPerturbation,right),dot(worldPerturbation,forward)),normalTS.z));
}

// Three world-shared arrays; local layer slots map to world palette slices.
// Reuse HDRP's guarded global sampler declarations; do not redeclare them.
TEXTURE2D_ARRAY(_LTRoadTerrainColor);
TEXTURE2D_ARRAY(_LTRoadTerrainNormal);
TEXTURE2D_ARRAY(_LTRoadTerrainMask);
// Each sampler follows its own texture: mask-only domain/depth programs strip color.
SAMPLER(sampler_LTRoadTerrainColor);
#define sampler_LTRoadTerrainNormal sampler_LTRoadTerrainColor
#define sampler_LTRoadTerrainMask sampler_LTRoadTerrainColor

float4 LTAutoSampleLayerMask(uint tile,int slot,float2 uv,float mip)
{
    return SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainMask,sampler_LTRoadTerrainMask,uv,LTAutoLayerSlice(tile,slot),mip);
}


// Coverage belongs to terrain XZ, not to a material projection. Projected callers
// share these three reads across their active axes; height masks remain per-axis.
void LTAutoReadLayerCoverage(uint tile,float2 coveragePosition,out float4 w0,out float4 w1,out float4 w2)
{
    w0=0;w1=0;w2=0;
    [branch] if(_LTRoadTerrainChunks[tile].options.z > .5)return;
    float2 coverageUV = (coveragePosition - _LTRoadTerrainChunks[tile].rect.xy) / _LTRoadTerrainChunks[tile].rect.zw;
    // Coverage texels include both endpoints, so adjacent chunks agree at their border.
    coverageUV = (coverageUV * 256.0 + .5) / 257.0;
    w0 = SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainWeights, sampler_LinearClamp, coverageUV, tile*3u+0u, 0);
    w1 = SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainWeights, sampler_LinearClamp, coverageUV, tile*3u+1u, 0);
    w2 = SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainWeights, sampler_LinearClamp, coverageUV, tile*3u+2u, 0);
}

// Road support is compiled only for chunks that need spline UVs or asphalt damage.
// Explicit gradients are supplied BEFORE the weight-dependent texture branches.
// Pre-height specialization: rank coverage once, then keep only two layer records.
// No 12-slot texture/mask/normal scratch arrays. Coverage is shared by all axes.
struct LTAutoLayerPairData
{
    int slot;
    float slice,raw;
    float4 tiling,tint,settings,flags;
};
struct LTAutoLayerPairSample
{
    float3 mask;
    float2 uv,dx,dy,right;
};
void LTAutoChooseLayerPair(uint tile,float4 w0,float4 w1,float4 w2,out int2 slots,out float2 raw)
{
    slots=0;raw=0;float2 slices=1e20;
    [loop] for(int rank=0;rank<12;rank++)
    {
        float4 group=rank<4?w0:rank<8?w1:w2;
        float w=group[rank&3],slice=LTAutoLayerSlice(tile,rank);
        if(w>0 && (w>raw.x || (w==raw.x && slice<slices.x)))
        {
            slots.y=slots.x;raw.y=raw.x;slices.y=slices.x;
            slots.x=rank;raw.x=w;slices.x=slice;
        }
        else if(w>0 && (w>raw.y || (w==raw.y && slice<slices.y)))
        {slots.y=rank;raw.y=w;slices.y=slice;}
    }
    if(slots.x==slots.y)raw.y=0;
    // Preserve ascending-slot accumulation order from the original sampler.
    if(slots.x>slots.y){slots=slots.yx;raw=raw.yx;}
}
void LTAutoLoadPairLayer(uint tile,int slot,float raw,out LTAutoLayerPairData layer)
{
    LTRoadTerrainLayer source=_LTRoadTerrainLayers[tile*12u+(uint)slot];
    layer.slot=slot;layer.raw=raw;layer.slice=source.indices.x;
    layer.tiling=source.tiling;layer.tint=source.tint;layer.settings=source.settings;layer.flags=source.flags;
}
void LTAutoPrepareLayerPair(uint tile,float4 w0,float4 w1,float4 w2,out LTAutoLayerPairData first,out LTAutoLayerPairData second)
{
    int2 slots;float2 raw;LTAutoChooseLayerPair(tile,w0,w1,w2,slots,raw);
    LTAutoLoadPairLayer(tile,slots.x,raw.x,first);LTAutoLoadPairLayer(tile,slots.y,raw.y,second);
}
