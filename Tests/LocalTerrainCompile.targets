    <Compile Remove="Assets\TerrainSystem\LocalTerrain\LTDetail*.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\LTDetail*.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\LTVehicleTerrainDeformer.cs" />
