    ao+=saturate(1+(mask.x-1)*layer.flags.y)*weight;
    smoothness+=mask.z*weight;metallic+=layer.settings.y*weight;
}
void LTAutoSampleLayerPair(uint tile,LTAutoLayerPairData first,LTAutoLayerPairData second,
    float2 coveragePosition,float2 coverageDx,float2 coverageDy,float2 position,float2 uvDx,float2 uvDy,int projectionAxis,
    out float3 color,out float3 normalTS,out float ao,out float smoothness,out float metallic,out float3 gradientLocal)
{
    LTAutoLayerPairSample a,b;
    LTAutoReadPairMask(tile,first,coveragePosition,coverageDx,coverageDy,position,uvDx,uvDy,a);
    LTAutoReadPairMask(tile,second,coveragePosition,coverageDx,coverageDy,position,uvDx,uvDy,b);
    float highest=-1;
    if(first.raw>.00001)highest=max(highest,a.mask.y+first.raw);
    if(second.raw>.00001)highest=max(highest,b.mask.y+second.raw);
    float2 weights=float2(first.raw,second.raw);
    if(_LTRoadTerrainChunks[tile].options.x>.0001)
        weights*=lerp(1,saturate((float2(a.mask.y,b.mask.y)+weights-highest+.2)/.2),_LTRoadTerrainChunks[tile].options.x);
    weights/=max(weights.x+weights.y,.00001);
    color=0;float3 n=0;ao=0;smoothness=0;metallic=0;
    LTAutoAccumulatePairLayer(tile,first,a,weights.x,coveragePosition,coverageDx,coverageDy,projectionAxis,color,n,ao,smoothness,metallic);
    LTAutoAccumulatePairLayer(tile,second,b,weights.y,coveragePosition,coverageDx,coverageDy,projectionAxis,color,n,ao,smoothness,metallic);
#if 1
    if(_LTRoadTerrainChunks[tile].options.w>.5)
    {gradientLocal=n;normalTS=normalize(float3(-n.x,-n.z,1));return;}
#endif
    normalTS=normalize(n+float3(0,0,.00001));gradientLocal=LTAutoProjectionGradient(tile,normalTS,projectionAxis);
}

