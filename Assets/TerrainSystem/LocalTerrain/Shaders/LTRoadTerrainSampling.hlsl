void LTAutoReadPairMask(uint tile,LTAutoLayerPairData layer,float2 coveragePosition,float2 coverageDx,float2 coverageDy,
    float2 position,float2 uvDx,float2 uvDy,out LTAutoLayerPairSample sample)
