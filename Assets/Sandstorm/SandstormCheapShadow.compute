#pragma kernel BuildMask
#pragma kernel BlurMask
#pragma target 5.0
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
Texture3D<float4> _ShadowDensityA, _ShadowDensityB;
SamplerState sampler_LinearClamp;
Texture2D<float> _BlurInput;
RWTexture2D<float> _ShadowOutput;
float4x4 _ShadowWorldToLocal;
float4 _ShadowRect, _ShadowAxes, _ShadowDensityParams, _BlurDirection;
float3 _ShadowSun;
float _ShadowGround, _ShadowBlend;
int _ShadowSize;
bool Box(float3 o,float3 d,out float a,out float b)
{
 a=0;b=1e20;
 [unroll] for(int k=0;k<3;k++)
 {
  if(abs(d[k])<1e-8) { if(o[k]<-.5 || o[k]>.5) return false; }
  else { float x=(-.5-o[k])/d[k],y=(.5-o[k])/d[k];a=max(a,min(x,y));b=min(b,max(x,y)); }
 }
 return b>a;
}
[numthreads(8,8,1)]
void BuildMask(uint3 id:SV_DispatchThreadID)
{
 if(any(id.xy>=(uint)_ShadowSize)) return;
 float2 xz=_ShadowRect.xy+(id.xy+.5)/_ShadowSize*_ShadowRect.zw;
 float3 origin=mul(_ShadowWorldToLocal,float4(xz.x,_ShadowGround,xz.y,1)).xyz;
 float3 dir=mul((float3x3)_ShadowWorldToLocal,_ShadowSun);
 float a,b;
 if(!Box(origin,dir,a,b)) { _ShadowOutput[id.xy]=0;return; }
 float sum=0,ds=(b-a)/8;
 // Coarse animated footprint: fixed eight density samples, no noise or light rays.
 [unroll] for(int j=0;j<8;j++)
 {
  float3 p=origin+dir*(a+(j+.5)*ds),uv=p+.5;
  float3 edge=min(uv,1-uv);
  float fade=_ShadowDensityParams.w>0 ? saturate(min(edge.x,min(edge.y,edge.z))/_ShadowDensityParams.w) : 1;
  if(_ShadowAxes.x>.5) uv=uv.xzy;
  uv=lerp(uv,1-uv,_ShadowAxes.yzw);
  float d=_ShadowDensityA.SampleLevel(sampler_LinearClamp,uv,0).r;
  if(_ShadowBlend>0) d=lerp(d,_ShadowDensityB.SampleLevel(sampler_LinearClamp,uv,0).r,_ShadowBlend);
  sum+=max(0,d-_ShadowDensityParams.y)*_ShadowDensityParams.x*fade*ds;
 }
 _ShadowOutput[id.xy]=1-exp(-sum*_ShadowDensityParams.z);
}
[numthreads(8,8,1)]
void BlurMask(uint3 id:SV_DispatchThreadID)
{
 if(any(id.xy>=(uint)_ShadowSize)) return;
 float2 uv=(id.xy+.5)/_ShadowSize;
 float sum=0,weight=0;
 [unroll] for(int j=-3;j<=3;j++)
 {
  float w=exp(-.5*j*j);
  float2 q=uv+_BlurDirection.xy*j;
  if(all(q>=0) && all(q<=1)) sum+=_BlurInput.SampleLevel(sampler_LinearClamp,q,0)*w;
  weight+=w;
 }
 _ShadowOutput[id.xy]=sum/weight;
}
