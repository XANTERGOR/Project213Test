#else
        c=SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainColor,sampler_LTRoadTerrainColor,sample.uv,layer.slice,sample.dx,sample.dy).rgb*layer.tint.rgb;
        if(layer.flags.x>.5)n=LTUnpackLayerNormal(SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainNormal,sampler_LTRoadTerrainNormal,sample.uv,layer.slice,sample.dx,sample.dy),layer.settings.x,layer.flags.x);
#endif
