    <Compile Remove="Assets\TerrainSystem\LocalTerrain\Editor\LTPaintBenchmark.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\Editor\LTPaintBenchmark.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\Editor\LTGlobalBakeSaving.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\Editor\LTGlobalBakeSaving.cs" />
  </ItemGroup>
</Project>
