#endif // _LT_FAST_COLOR_REMAINDER
#else
    float4 tiling[12]={_LTRoadTerrainLayers[tile*12u+0u].tiling,_LTRoadTerrainLayers[tile*12u+1u].tiling,_LTRoadTerrainLayers[tile*12u+2u].tiling,_LTRoadTerrainLayers[tile*12u+3u].tiling,_LTRoadTerrainLayers[tile*12u+4u].tiling,_LTRoadTerrainLayers[tile*12u+5u].tiling,
        _LTRoadTerrainLayers[tile*12u+6u].tiling,_LTRoadTerrainLayers[tile*12u+7u].tiling,_LTRoadTerrainLayers[tile*12u+8u].tiling,_LTRoadTerrainLayers[tile*12u+9u].tiling,_LTRoadTerrainLayers[tile*12u+10u].tiling,_LTRoadTerrainLayers[tile*12u+11u].tiling};
    float4 tint[12]={_LTRoadTerrainLayers[tile*12u+0u].tint,_LTRoadTerrainLayers[tile*12u+1u].tint,_LTRoadTerrainLayers[tile*12u+2u].tint,_LTRoadTerrainLayers[tile*12u+3u].tint,_LTRoadTerrainLayers[tile*12u+4u].tint,_LTRoadTerrainLayers[tile*12u+5u].tint,
        _LTRoadTerrainLayers[tile*12u+6u].tint,_LTRoadTerrainLayers[tile*12u+7u].tint,_LTRoadTerrainLayers[tile*12u+8u].tint,_LTRoadTerrainLayers[tile*12u+9u].tint,_LTRoadTerrainLayers[tile*12u+10u].tint,_LTRoadTerrainLayers[tile*12u+11u].tint};
    float4 settings[12]={_LTRoadTerrainLayers[tile*12u+0u].settings,_LTRoadTerrainLayers[tile*12u+1u].settings,_LTRoadTerrainLayers[tile*12u+2u].settings,_LTRoadTerrainLayers[tile*12u+3u].settings,_LTRoadTerrainLayers[tile*12u+4u].settings,_LTRoadTerrainLayers[tile*12u+5u].settings,
        _LTRoadTerrainLayers[tile*12u+6u].settings,_LTRoadTerrainLayers[tile*12u+7u].settings,_LTRoadTerrainLayers[tile*12u+8u].settings,_LTRoadTerrainLayers[tile*12u+9u].settings,_LTRoadTerrainLayers[tile*12u+10u].settings,_LTRoadTerrainLayers[tile*12u+11u].settings};
    float4 flags[12]={_LTRoadTerrainLayers[tile*12u+0u].flags,_LTRoadTerrainLayers[tile*12u+1u].flags,_LTRoadTerrainLayers[tile*12u+2u].flags,_LTRoadTerrainLayers[tile*12u+3u].flags,_LTRoadTerrainLayers[tile*12u+4u].flags,_LTRoadTerrainLayers[tile*12u+5u].flags,
        _LTRoadTerrainLayers[tile*12u+6u].flags,_LTRoadTerrainLayers[tile*12u+7u].flags,_LTRoadTerrainLayers[tile*12u+8u].flags,_LTRoadTerrainLayers[tile*12u+9u].flags,_LTRoadTerrainLayers[tile*12u+10u].flags,_LTRoadTerrainLayers[tile*12u+11u].flags};
    float raw[12]={w0.x,w0.y,w0.z,w0.w,w1.x,w1.y,w1.z,w1.w,w2.x,w2.y,w2.z,w2.w};
    bool topTwo=_LTRoadTerrainChunks[tile].fastLayerParams.z>.5;
    float weights[12];float3 masks[12];
#if 1
    float2 mappedUV[12],mappedDx[12],mappedDy[12],mappedRight[12];
#endif
    float maxHeight=-1;
    // Post-height/general mode retains every candidate.
    [loop] for(int i=0;i<12;i++)
    {
        float3 mask=float3(1,.5,settings[i].z);
        [branch] if(raw[i]>.00001)
        {
            float2 scale=max(tiling[i].xy,.001);
            float2 uv=position/scale+tiling[i].zw;
            float2 dx=uvDx/scale,dy=uvDy/scale;
#if 1
            float2 roadRight;
            LTAutoRoadMappedUV(tile,i,coveragePosition,coverageDx,coverageDy,uv,dx,dy,roadRight);
            mappedUV[i]=uv;mappedDx[i]=dx;mappedDy[i]=dy;mappedRight[i]=roadRight;
#endif
            [branch] if(settings[i].w>.5)
            {
#if defined(SHADER_STAGE_RAY_TRACING)
            mask=SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainMask,sampler_LTRoadTerrainMask,uv,LTAutoLayerSlice(tile,i),0).rgb;
#else
            mask=SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainMask,sampler_LTRoadTerrainMask,uv,LTAutoLayerSlice(tile,i),dx,dy).rgb;
#endif
            }
        }
        // Cracks change AO/smoothness but never height. Apply them only to survivors,
        // before AO strength, exactly as in the full sampler.
        mask.y=saturate((mask.y-.5)*flags[i].z+.5+flags[i].w);
        masks[i]=mask;
        if(raw[i]>.00001)maxHeight=max(maxHeight,mask.y+raw[i]);
    }
    float total=0;
    [loop] for(int j=0;j<12;j++)
    {
        float w=raw[j];
        if(_LTRoadTerrainChunks[tile].options.x>.0001)
            w*=lerp(1,saturate((masks[j].y+w-maxHeight+.2)/.2),_LTRoadTerrainChunks[tile].options.x);
        weights[j]=w;total+=w;
    }
    [loop] for(int q=0;q<12;q++)weights[q]/=max(total,.00001);

    // Pre-height selection lives in a separate compiled implementation.
    [branch] if(topTwo && total>.00001)
    {
        int firstSlot,secondSlot;LTAutoStrongestLayerPair(tile,weights,firstSlot,secondSlot);
        // Do not double-count a single winning slot.
        float kept=max(weights[firstSlot]+(secondSlot!=firstSlot?weights[secondSlot]:0),.00001);
        [loop] for(int keep=0;keep<12;keep++)
            weights[keep]=(keep==firstSlot || keep==secondSlot)?weights[keep]/kept:0;
    }
    else [branch] if(!topTwo && _LTRoadTerrainChunks[tile].fastLayerParams.x>0 && total>.00001)
    {
        float first=0,second=0,third=0;
        [loop] for(int rank=0;rank<12;rank++)
        {
            float w=weights[rank];
            third=max(third,min(second,w));
            second=max(second,min(first,w));first=max(first,w);
        }
        // Continuous soft threshold, not hard top-two selection. A fixed divisor
        // avoids discontinuities when the number of nonzero layers changes.
        // At most 'budget' total normalized weight is removed, before renormalizing.
        float cutoff=min(third,clamp(_LTRoadTerrainChunks[tile].fastLayerParams.x,0,.15)/12);
        float kept=0;
        [loop] for(int r=0;r<12;r++){weights[r]=max(weights[r]-cutoff,0);kept+=weights[r];}
        [loop] for(int s=0;s<12;s++)weights[s]/=max(kept,.00001);
    }
    color=0;float3 n=0;ao=0;smoothness=0;metallic=0;
    [loop] for(int k=0;k<12;k++)
    {
        float w=weights[k];
        // Height-rejected/sparsified layers never fetch their albedo or normal.
        [branch] if(w>0)
        {
            float3 c=0;
            float3 mask=masks[k];
#if 1
            float2 roadRight=float2(1,0);
#endif
            // Match legacy defaults for tiny, unsampled coverage slots as well.
            float3 normal=k<8?float3(0,0,1):float3(0,0,0);
            [branch] if(raw[k]>.00001)
            {
                normal=float3(0,0,1);
                float2 scale=max(tiling[k].xy,.001);
                float2 uv=position/scale+tiling[k].zw;
                float2 dx=uvDx/scale,dy=uvDy/scale;
#if 1
                uv=mappedUV[k];dx=mappedDx[k];dy=mappedDy[k];roadRight=mappedRight[k];
#endif
#if defined(SHADER_STAGE_RAY_TRACING)
                c=SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainColor,sampler_LTRoadTerrainColor,uv,LTAutoLayerSlice(tile,k),0).rgb*tint[k].rgb;
                if(flags[k].x>.5)normal=LTUnpackLayerNormal(SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainNormal,sampler_LTRoadTerrainNormal,uv,LTAutoLayerSlice(tile,k),0),settings[k].x,flags[k].x);
#else
                c=SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainColor,sampler_LTRoadTerrainColor,uv,LTAutoLayerSlice(tile,k),dx,dy).rgb*tint[k].rgb;
                if(flags[k].x>.5)normal=LTUnpackLayerNormal(SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainNormal,sampler_LTRoadTerrainNormal,uv,LTAutoLayerSlice(tile,k),dx,dy),settings[k].x,flags[k].x);
#endif
#if 1
                LTAutoApplyAsphaltCracks(tile,k,coveragePosition,coverageDx,coverageDy,roadRight,c,normal,mask);
#endif
            }
#if 1
            if(_LTRoadTerrainChunks[tile].options.w>.5)normal=LTAutoRoadLayerGradient(tile,k,normal,roadRight,projectionAxis);
#endif
            color+=c*w;n+=normal*w;ao+=saturate(1+(mask.x-1)*flags[k].y)*w;
            smoothness+=mask.z*w;metallic+=settings[k].y*w;
        }
    }
#if 1
    if(_LTRoadTerrainChunks[tile].options.w>.5)
    {
        gradientLocal=n;normalTS=normalize(float3(-n.x,-n.z,1));return;
    }
#endif
    normalTS=normalize(n+float3(0,0,.00001));
    gradientLocal=LTAutoProjectionGradient(tile,normalTS,projectionAxis);
#endif // _LT_FAST_PREHEIGHT
}

void LTAutoSampleLayersMappedFrameWithCoverageFull(uint tile,float2 coveragePosition, float2 coverageDx, float2 coverageDy,
    float2 position, float2 uvDx, float2 uvDy, int projectionAxis,
    float4 w0,float4 w1,float4 w2,
    out float3 color, out float3 normalTS, out float ao, out float smoothness, out float metallic,
    out float3 gradientLocal)
{
    gradientLocal=0;
    color=0;normalTS=float3(0,0,1);ao=1;smoothness=0;metallic=0;
    // Uniform per-chunk fast path. No coverage reads, layer arrays or height
    // blending on chunks containing only the background. The baker shares this path.
    [branch] if(_LTRoadTerrainChunks[tile].options.z > .5)
    {
        float2 uv=position/max(_LTRoadTerrainLayers[tile*12u+0u].tiling.xy,.001)+_LTRoadTerrainLayers[tile*12u+0u].tiling.zw;
        float3 mask=float3(1,.5,_LTRoadTerrainLayers[tile*12u+0u].settings.z);
        float3 n=float3(0,0,1);
#if defined(SHADER_STAGE_RAY_TRACING)
        color=SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainColor,sampler_LTRoadTerrainColor,uv,LTAutoLayerSlice(tile,0),0).rgb*_LTRoadTerrainLayers[tile*12u+0u].tint.rgb;
        if(_LTRoadTerrainLayers[tile*12u+0u].settings.w > .5) mask=SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainMask,sampler_LTRoadTerrainMask,uv,LTAutoLayerSlice(tile,0),0).rgb;
        if(_LTRoadTerrainLayers[tile*12u+0u].flags.x > .5) n=LTUnpackLayerNormal(SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainNormal,sampler_LTRoadTerrainNormal,uv,LTAutoLayerSlice(tile,0),0),_LTRoadTerrainLayers[tile*12u+0u].settings.x,_LTRoadTerrainLayers[tile*12u+0u].flags.x);
#else
        float2 dx=uvDx/max(_LTRoadTerrainLayers[tile*12u+0u].tiling.xy,.001),dy=uvDy/max(_LTRoadTerrainLayers[tile*12u+0u].tiling.xy,.001);
        color=SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainColor,sampler_LTRoadTerrainColor,uv,LTAutoLayerSlice(tile,0),dx,dy).rgb*_LTRoadTerrainLayers[tile*12u+0u].tint.rgb;
        if(_LTRoadTerrainLayers[tile*12u+0u].settings.w > .5) mask=SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainMask,sampler_LTRoadTerrainMask,uv,LTAutoLayerSlice(tile,0),dx,dy).rgb;
        if(_LTRoadTerrainLayers[tile*12u+0u].flags.x > .5) n=LTUnpackLayerNormal(SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainNormal,sampler_LTRoadTerrainNormal,uv,LTAutoLayerSlice(tile,0),dx,dy),_LTRoadTerrainLayers[tile*12u+0u].settings.x,_LTRoadTerrainLayers[tile*12u+0u].flags.x);
#endif
        normalTS=normalize(n+float3(0,0,.00001));
        ao=saturate(1+(mask.x-1)*_LTRoadTerrainLayers[tile*12u+0u].flags.y);smoothness=mask.z;metallic=_LTRoadTerrainLayers[tile*12u+0u].settings.y;
        gradientLocal=LTAutoProjectionGradient(tile,normalTS,projectionAxis);
        return;
    }
    float weights[12] = {w0.x,w0.y,w0.z,w0.w,w1.x,w1.y,w1.z,w1.w,w2.x,w2.y,w2.z,w2.w};
    float3 colors[12], normals[12], masks[12];

    // Do not fetch spline maps/Jacobians for layers below the existing sampling
    // threshold. Keep their flat-normal/default-mask contribution: a tiny positive
    // weight still reaches height blending. Flat normals have zero slope in any
    // road frame, so an unsampled layer may use the identity roadRight safely.

    {
        float2 roadRight=float2(1,0);
        colors[0] = 0; normals[0] = float3(0,0,1); masks[0] = float3(1,.5,_LTRoadTerrainLayers[tile*12u+0u].settings.z);
        [branch] if(weights[0] > 0.00001)
        {
            float2 uv = position / max(_LTRoadTerrainLayers[tile*12u+0u].tiling.xy, .001) + _LTRoadTerrainLayers[tile*12u+0u].tiling.zw;
            float2 dx=uvDx/max(_LTRoadTerrainLayers[tile*12u+0u].tiling.xy,.001),dy=uvDy/max(_LTRoadTerrainLayers[tile*12u+0u].tiling.xy,.001);
            LTAutoRoadMappedUV(tile,0,coveragePosition,coverageDx,coverageDy,uv,dx,dy,roadRight);
#if defined(SHADER_STAGE_RAY_TRACING)
            colors[0] = SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainColor,sampler_LTRoadTerrainColor,uv,LTAutoLayerSlice(tile,0), 0).rgb * _LTRoadTerrainLayers[tile*12u+0u].tint.rgb;
            if(_LTRoadTerrainLayers[tile*12u+0u].settings.w > .5) masks[0] = SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainMask,sampler_LTRoadTerrainMask,uv,LTAutoLayerSlice(tile,0), 0).rgb;
            if(_LTRoadTerrainLayers[tile*12u+0u].flags.x > .5) normals[0] = LTUnpackLayerNormal(SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainNormal,sampler_LTRoadTerrainNormal,uv,LTAutoLayerSlice(tile,0), 0),_LTRoadTerrainLayers[tile*12u+0u].settings.x,_LTRoadTerrainLayers[tile*12u+0u].flags.x);
#else
            // Explicit gradients remain valid in weight-dependent branches.
            colors[0] = SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainColor,sampler_LTRoadTerrainColor,uv,LTAutoLayerSlice(tile,0), dx, dy).rgb * _LTRoadTerrainLayers[tile*12u+0u].tint.rgb;
            if(_LTRoadTerrainLayers[tile*12u+0u].settings.w > .5) masks[0] = SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainMask,sampler_LTRoadTerrainMask,uv,LTAutoLayerSlice(tile,0), dx, dy).rgb;
            if(_LTRoadTerrainLayers[tile*12u+0u].flags.x > .5) normals[0] = LTUnpackLayerNormal(SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainNormal,sampler_LTRoadTerrainNormal,uv,LTAutoLayerSlice(tile,0), dx, dy),_LTRoadTerrainLayers[tile*12u+0u].settings.x,_LTRoadTerrainLayers[tile*12u+0u].flags.x);
#endif
        }
        if(weights[0]>.00001)LTAutoApplyAsphaltCracks(tile,0,coveragePosition,coverageDx,coverageDy,roadRight,colors[0],normals[0],masks[0]);
        [branch] if(_LTRoadTerrainChunks[tile].options.w>.5)
            normals[0]=LTAutoRoadLayerGradient(tile,0,normals[0],roadRight,projectionAxis);
    }

    {
        float2 roadRight=float2(1,0);
        colors[1] = 0; normals[1] = float3(0,0,1); masks[1] = float3(1,.5,_LTRoadTerrainLayers[tile*12u+1u].settings.z);
        [branch] if(weights[1] > 0.00001)
        {
            float2 uv = position / max(_LTRoadTerrainLayers[tile*12u+1u].tiling.xy, .001) + _LTRoadTerrainLayers[tile*12u+1u].tiling.zw;
            float2 dx=uvDx/max(_LTRoadTerrainLayers[tile*12u+1u].tiling.xy,.001),dy=uvDy/max(_LTRoadTerrainLayers[tile*12u+1u].tiling.xy,.001);
            LTAutoRoadMappedUV(tile,1,coveragePosition,coverageDx,coverageDy,uv,dx,dy,roadRight);
#if defined(SHADER_STAGE_RAY_TRACING)
            colors[1] = SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainColor,sampler_LTRoadTerrainColor,uv,LTAutoLayerSlice(tile,1), 0).rgb * _LTRoadTerrainLayers[tile*12u+1u].tint.rgb;
            if(_LTRoadTerrainLayers[tile*12u+1u].settings.w > .5) masks[1] = SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainMask,sampler_LTRoadTerrainMask,uv,LTAutoLayerSlice(tile,1), 0).rgb;
            if(_LTRoadTerrainLayers[tile*12u+1u].flags.x > .5) normals[1] = LTUnpackLayerNormal(SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainNormal,sampler_LTRoadTerrainNormal,uv,LTAutoLayerSlice(tile,1), 0),_LTRoadTerrainLayers[tile*12u+1u].settings.x,_LTRoadTerrainLayers[tile*12u+1u].flags.x);
#else
            // Explicit gradients remain valid in weight-dependent branches.
            colors[1] = SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainColor,sampler_LTRoadTerrainColor,uv,LTAutoLayerSlice(tile,1), dx, dy).rgb * _LTRoadTerrainLayers[tile*12u+1u].tint.rgb;
            if(_LTRoadTerrainLayers[tile*12u+1u].settings.w > .5) masks[1] = SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainMask,sampler_LTRoadTerrainMask,uv,LTAutoLayerSlice(tile,1), dx, dy).rgb;
            if(_LTRoadTerrainLayers[tile*12u+1u].flags.x > .5) normals[1] = LTUnpackLayerNormal(SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainNormal,sampler_LTRoadTerrainNormal,uv,LTAutoLayerSlice(tile,1), dx, dy),_LTRoadTerrainLayers[tile*12u+1u].settings.x,_LTRoadTerrainLayers[tile*12u+1u].flags.x);
#endif
        }
        if(weights[1]>.00001)LTAutoApplyAsphaltCracks(tile,1,coveragePosition,coverageDx,coverageDy,roadRight,colors[1],normals[1],masks[1]);
        [branch] if(_LTRoadTerrainChunks[tile].options.w>.5)
            normals[1]=LTAutoRoadLayerGradient(tile,1,normals[1],roadRight,projectionAxis);
    }

    {
        float2 roadRight=float2(1,0);
        colors[2] = 0; normals[2] = float3(0,0,1); masks[2] = float3(1,.5,_LTRoadTerrainLayers[tile*12u+2u].settings.z);
        [branch] if(weights[2] > 0.00001)
        {
            float2 uv = position / max(_LTRoadTerrainLayers[tile*12u+2u].tiling.xy, .001) + _LTRoadTerrainLayers[tile*12u+2u].tiling.zw;
            float2 dx=uvDx/max(_LTRoadTerrainLayers[tile*12u+2u].tiling.xy,.001),dy=uvDy/max(_LTRoadTerrainLayers[tile*12u+2u].tiling.xy,.001);
            LTAutoRoadMappedUV(tile,2,coveragePosition,coverageDx,coverageDy,uv,dx,dy,roadRight);
#if defined(SHADER_STAGE_RAY_TRACING)
            colors[2] = SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainColor,sampler_LTRoadTerrainColor,uv,LTAutoLayerSlice(tile,2), 0).rgb * _LTRoadTerrainLayers[tile*12u+2u].tint.rgb;
            if(_LTRoadTerrainLayers[tile*12u+2u].settings.w > .5) masks[2] = SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainMask,sampler_LTRoadTerrainMask,uv,LTAutoLayerSlice(tile,2), 0).rgb;
            if(_LTRoadTerrainLayers[tile*12u+2u].flags.x > .5) normals[2] = LTUnpackLayerNormal(SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainNormal,sampler_LTRoadTerrainNormal,uv,LTAutoLayerSlice(tile,2), 0),_LTRoadTerrainLayers[tile*12u+2u].settings.x,_LTRoadTerrainLayers[tile*12u+2u].flags.x);
#else
            // Explicit gradients remain valid in weight-dependent branches.
            colors[2] = SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainColor,sampler_LTRoadTerrainColor,uv,LTAutoLayerSlice(tile,2), dx, dy).rgb * _LTRoadTerrainLayers[tile*12u+2u].tint.rgb;
            if(_LTRoadTerrainLayers[tile*12u+2u].settings.w > .5) masks[2] = SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainMask,sampler_LTRoadTerrainMask,uv,LTAutoLayerSlice(tile,2), dx, dy).rgb;
            if(_LTRoadTerrainLayers[tile*12u+2u].flags.x > .5) normals[2] = LTUnpackLayerNormal(SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainNormal,sampler_LTRoadTerrainNormal,uv,LTAutoLayerSlice(tile,2), dx, dy),_LTRoadTerrainLayers[tile*12u+2u].settings.x,_LTRoadTerrainLayers[tile*12u+2u].flags.x);
#endif
        }
        if(weights[2]>.00001)LTAutoApplyAsphaltCracks(tile,2,coveragePosition,coverageDx,coverageDy,roadRight,colors[2],normals[2],masks[2]);
        [branch] if(_LTRoadTerrainChunks[tile].options.w>.5)
            normals[2]=LTAutoRoadLayerGradient(tile,2,normals[2],roadRight,projectionAxis);
    }

    {
        float2 roadRight=float2(1,0);
        colors[3] = 0; normals[3] = float3(0,0,1); masks[3] = float3(1,.5,_LTRoadTerrainLayers[tile*12u+3u].settings.z);
        [branch] if(weights[3] > 0.00001)
        {
            float2 uv = position / max(_LTRoadTerrainLayers[tile*12u+3u].tiling.xy, .001) + _LTRoadTerrainLayers[tile*12u+3u].tiling.zw;
            float2 dx=uvDx/max(_LTRoadTerrainLayers[tile*12u+3u].tiling.xy,.001),dy=uvDy/max(_LTRoadTerrainLayers[tile*12u+3u].tiling.xy,.001);
            LTAutoRoadMappedUV(tile,3,coveragePosition,coverageDx,coverageDy,uv,dx,dy,roadRight);
#if defined(SHADER_STAGE_RAY_TRACING)
            colors[3] = SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainColor,sampler_LTRoadTerrainColor,uv,LTAutoLayerSlice(tile,3), 0).rgb * _LTRoadTerrainLayers[tile*12u+3u].tint.rgb;
            if(_LTRoadTerrainLayers[tile*12u+3u].settings.w > .5) masks[3] = SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainMask,sampler_LTRoadTerrainMask,uv,LTAutoLayerSlice(tile,3), 0).rgb;
            if(_LTRoadTerrainLayers[tile*12u+3u].flags.x > .5) normals[3] = LTUnpackLayerNormal(SAMPLE_TEXTURE2D_ARRAY_LOD(_LTRoadTerrainNormal,sampler_LTRoadTerrainNormal,uv,LTAutoLayerSlice(tile,3), 0),_LTRoadTerrainLayers[tile*12u+3u].settings.x,_LTRoadTerrainLayers[tile*12u+3u].flags.x);
#else
            // Explicit gradients remain valid in weight-dependent branches.
            colors[3] = SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainColor,sampler_LTRoadTerrainColor,uv,LTAutoLayerSlice(tile,3), dx, dy).rgb * _LTRoadTerrainLayers[tile*12u+3u].tint.rgb;
            if(_LTRoadTerrainLayers[tile*12u+3u].settings.w > .5) masks[3] = SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainMask,sampler_LTRoadTerrainMask,uv,LTAutoLayerSlice(tile,3), dx, dy).rgb;
            if(_LTRoadTerrainLayers[tile*12u+3u].flags.x > .5) normals[3] = LTUnpackLayerNormal(SAMPLE_TEXTURE2D_ARRAY_GRAD(_LTRoadTerrainNormal,sampler_LTRoadTerrainNormal,uv,LTAutoLayerSlice(tile,3), dx, dy),_LTRoadTerrainLayers[tile*12u+3u].settings.x,_LTRoadTerrainLayers[tile*12u+3u].flags.x);
