    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\Editor\LTDetailGpuLifetimeCheck.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\Editor\LTDetailGpuCheck.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\Editor\LTDetailGpuCheck.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\Editor\LTDetailGpuShaderImporter.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\Editor\LTDetailGpuShaderImporter.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\Editor\LTDetailMotionDebug.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\Editor\LTDetailMotionDebug.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\Editor\LTDetailProfileCapture.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\Editor\LTDetailProfileCapture.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\Editor\LTDetailInspector.cs" />
