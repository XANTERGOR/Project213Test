<Project>
  <!-- Unity may not regenerate its csproj until the Editor next gains focus. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Assembly-CSharp'">
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\LTLayerArrayBakeAsset.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\LTLayerArrayBakeAsset.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\LTLayerTextureArrays.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\LTLayerTextureArrays.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\LTRoad*.cs" />
