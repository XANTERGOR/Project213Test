    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\LTTerrainDeformer.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\LTDeformationMath.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\LTDeformationMath.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\LTPaintDeformation.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\LTPaintDeformation.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\LTPaintRocks.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\LTPaintRocks.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\LTPaintCpuCapture.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\LTPaintCpuCapture.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\LTPaintRuntime.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\LTPaintRuntime.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\LTPaintMath.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\LTPaintMath.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\LTPaintGlobals.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\LTPaintGlobals.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\LTGlobalBakeAsset.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\LTGlobalBakeAsset.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Assembly-CSharp-Editor'">
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\Editor\LTLayerArraySaving.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\Editor\LTLayerArraySaving.cs" />
    <Compile Remove="Assets\TerrainSystem\LocalTerrain\Editor\LTRoad*.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Assets\TerrainSystem\LocalTerrain\Editor\LTRoad*.cs" />
